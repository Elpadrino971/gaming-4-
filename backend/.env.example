# ==============================================
# BINGOSHOP - BACKEND ENVIRONMENT VARIABLES
# ==============================================

# DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/bingoshop?schema=public"

# JWT AUTHENTICATION
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# STRIPE PAYMENT
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Stripe Price IDs
STRIPE_PRICE_STARTER="price_xxxxxxxxxxxxx"
STRIPE_PRICE_BASIC="price_xxxxxxxxxxxxx"
STRIPE_PRICE_POPULAR="price_xxxxxxxxxxxxx"
STRIPE_PRICE_PREMIUM="price_xxxxxxxxxxxxx"
STRIPE_PRICE_MEGA="price_xxxxxxxxxxxxx"

# EMAIL SERVICE (SendGrid)
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@bingoshop.fr"
EMAIL_FROM_NAME="BingoShop"

# CORS & FRONTEND
FRONTEND_URL="http://localhost:3000"

# SERVER
PORT=3001
NODE_ENV="development"

# ADMIN DEFAULT
ADMIN_EMAIL="admin@bingoshop.fr"
ADMIN_PASSWORD="ChangeMeInProduction123!"

# BETA MODE
BETA_MODE="true"
